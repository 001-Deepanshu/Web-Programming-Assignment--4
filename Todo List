<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Advanced To-Do List</title>

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}

body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    transition:0.3s;
}

body.light{background:linear-gradient(135deg,#1d2671,#c33764);color:white}
body.dark{background:#121212;color:#eee}

.container{
    background:rgba(255,255,255,0.1);
    backdrop-filter:blur(15px);
    padding:25px;
    border-radius:15px;
    width:400px;
    box-shadow:0 10px 25px rgba(0,0,0,0.3);
}

h2{text-align:center;margin-bottom:15px}

.input-box{
    display:flex;
    gap:5px;
}

input,select{
    padding:8px;
    border:none;
    border-radius:5px;
}

button{
    padding:8px 12px;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

.add-btn{background:#00c6ff;color:white}

ul{list-style:none;margin-top:15px}

li{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:rgba(255,255,255,0.2);
    margin:8px 0;
    padding:10px;
    border-radius:8px;
}

.completed{text-decoration:line-through;opacity:0.6}

.actions button{margin-left:5px}

.filter{
    margin-top:10px;
    display:flex;
    justify-content:space-between;
}

.toggle-theme{
    margin-top:10px;
    width:100%;
}
</style>
</head>

<body class="light">

<div class="container">
    <h2>📝 Advanced To-Do</h2>

    <div class="input-box">
        <input type="text" id="taskInput" placeholder="Task...">
        <input type="date" id="dueDate">
        <button class="add-btn" onclick="addTask()">Add</button>
    </div>

    <div class="filter">
        <button onclick="setFilter('all')">All</button>
        <button onclick="setFilter('completed')">Completed</button>
        <button onclick="setFilter('pending')">Pending</button>
    </div>

    <button class="toggle-theme" onclick="toggleTheme()">🌙 Toggle Theme</button>

    <ul id="taskList"></ul>
</div>

<script>
let tasks=JSON.parse(localStorage.getItem("tasks"))||[];
let filter="all";

function save(){localStorage.setItem("tasks",JSON.stringify(tasks))}

function notify(msg){
    if(Notification.permission==='granted') new Notification(msg);
    else Notification.requestPermission();
}

function render(){
    const list=document.getElementById("taskList");
    list.innerHTML="";

    tasks
    .filter(t=>filter==='all'||(filter==='completed'&&t.completed)||(filter==='pending'&&!t.completed))
    .forEach((t,i)=>{
        const li=document.createElement("li");
        if(t.completed) li.classList.add("completed");

        li.innerHTML=`
            <div>
                <strong>${t.text}</strong><br>
                <small>${t.date||''}</small>
            </div>
            <div class="actions">
                <button onclick="toggle(${i})">✔</button>
                <button onclick="remove(${i})">✖</button>
            </div>
        `;

        list.appendChild(li);

        // due date notification
        if(t.date && !t.completed){
            const today=new Date().toISOString().split('T')[0];
            if(t.date===today) notify("Task due today: "+t.text);
        }
    });
}

function addTask(){
    const text=document.getElementById("taskInput").value.trim();
    const date=document.getElementById("dueDate").value;

    if(!text) return alert("Enter task!");

    tasks.push({text,completed:false,date});
    save();
    render();

    document.getElementById("taskInput").value="";
}

function toggle(i){
    tasks[i].completed=!tasks[i].completed;
    save();
    render();
}

function remove(i){
    tasks.splice(i,1);
    save();
    render();
}

function setFilter(f){filter=f;render()}

function toggleTheme(){
    document.body.classList.toggle("dark");
    document.body.classList.toggle("light");
}

render();
</script>

</body>
</html>
